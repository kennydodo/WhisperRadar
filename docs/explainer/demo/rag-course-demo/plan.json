  {
   "id": "chunking",
   "start": "First, we split the text",
   "layout": "code_lesson",
   "title": "Step 1: split into chunks",
   "filename": "chunking.py",
   "motion": {
    "at": "Here is a short handbook"
   },
   "lines": [
    "text = (\"Items can be returned within 30 days for a full refund. \"",
    "        \"Shipping takes 3 to 5 working days. \"",
    "        \"Our stores open at 9 am and close at 6 pm.\")",
    "",
    "sentences = [s.strip() + \".\" for s in text.split(\".\") if s.strip()]",
    "",
    "def chunk(sentences, size):",
    "    return [\" \".join(sentences[i:i + size])",
    "            for i in range(0, len(sentences), size)]",
    "",
    "chunks = chunk(sentences, 1)",
    "for i, c in enumerate(chunks):",
    "    print(i, c)"
   ],
   "highlights": [
    {
     "line": 5,
     "at": "We cut it into sentences",
     "note": "one per sentence"
    },
    {
     "line": 7,
     "at": "The chunk function steps",
     "note": "size at a time"
    }
   ],
   "output": {
    "label": "Output",
    "lines": [
     "0 Items can be returned within 30 days for a full refund.",
     "1 Shipping takes 3 to 5 working days.",
     "2 Our stores open at 9 am and close at 6 pm."
    ],
    "at": "Running it prints"
   },
   "footer": {
    "text": "Small chunks keep the search precise",
    "at": "Small chunks keep the search precise"
   }
  },
  {
   "id": "keyword_search",
   "start": "Now the search",
   "layout": "code_lesson",
   "title": "Step 2: keyword search",
   "filename": "keyword_search.py",
   "motion": {
    "at": "Now the search"
   },
   "chips": [
    {
     "label": "Keyword search",
     "color": "accent",
     "at": "Now the search"
    },
    {
     "label": "TF-IDF",
     "color": "good",
     "at": "keyword search with TF-IDF"
    }
   ],
   "lines": [
    "from sklearn.feature_extraction.text import TfidfVectorizer",
    "from sklearn.metrics.pairwise import cosine_similarity",
    "chunks = [\"Items can be returned within 30 days for a full refund.\",",
    "          \"Shipping takes 3 to 5 working days.\",",
    "          \"Our stores open at 9 am and close at 6 pm.\"]",
    "",
    "vectorizer = TfidfVectorizer()",
    "chunk_vectors = vectorizer.fit_transform(chunks)",
    "",
    "query = \"How do I send an item back?\"",
    "scores = cosine_similarity(vectorizer.transform([query]), chunk_vectors)[0]",
    "",
    "for chunk, score in zip(chunks, scores):",
    "    print(f\"{score:.2f}  {chunk}\")"
   ],
   "highlights": [
    {
     "line": 7,
     "at": "We build a vectorizer",
     "note": "learns word weights"
    },
    {
     "line": 10,
     "at": "how do I send an item back",
     "note": "the question"
    }
   ],
   "output": {
    "label": "Output",
    "lines": [
     "0.00  Items can be returned within 30 days for a full refund.",
     "0.00  Shipping takes 3 to 5 working days.",
     "0.00  Our stores open at 9 am and close at 6 pm."
    ],
    "at": "Look at the output"
   },
   "footer": {
    "text": "Same words match, same meaning does not",
    "at": "Keyword search only matches"
   }
